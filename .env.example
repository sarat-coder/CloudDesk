# Local demo defaults; leave external credentials blank unless you configure that provider.
DEMO_MODE=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Configure a strong secret before enabling real authentication.
JWT_SECRET=
SUPABASE_JWT_SECRET=

DATABASE_URL=sqlite+aiosqlite:///./data/support.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
REDIS_URL=
USE_FAKE_REDIS=true

LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=fake

EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake
EMBEDDING_DIMENSIONS=384

VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=clouddesk_knowledge

APPROVAL_REQUIRED_FOR_REFUNDS=true
MAX_REFUND_WITHOUT_APPROVAL=0
TOOL_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
SAMPLE_DATA_DIR=sample_data

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clouddesk-support
